# ========================================================
# Utah Telugu Association (UTA) Digital Platform 2.0
# Environment Configuration Template
# ========================================================

# Database URL
# For local development with SQLite: "file:./dev.db"
# For production PostgreSQL / Supabase / Neon: "postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DATABASE_URL="file:./dev.db"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Timezone & Localization
NEXT_PUBLIC_DEFAULT_TIMEZONE="America/Denver"
NEXT_PUBLIC_SITE_NAME="Utah Telugu Association"

# Authentication & Session Signing Key
# Generate a strong 64-char key in production: `openssl rand -hex 32`
NEXTAUTH_SECRET="change_me_to_a_secure_random_key_in_production"

# Zeffy Non-Profit Payment Integration
ZEFFY_ORG_ID="uta-utah-telugu-association"
ZEFFY_WEBHOOK_SECRET="change_me_to_production_zeffy_webhook_secret"

# Node Environment
NODE_ENV="development"
